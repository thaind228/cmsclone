var connectionString = "";
var namespaceName = "CmsBase.DataAccess";
var className = "CmsDataAccess";
var procedures = new string[0]; // Replace with new[] { "dbo.ProcedureName" }.

var definitions = new List<Procedure>();
if (procedures.Length > 0)
{
    if (string.IsNullOrWhiteSpace(connectionString))
        throw new InvalidOperationException("Set connectionString before generating DAO methods.");

    using (var connection = new SqlConnection(connectionString))
    {
        connection.Open();
        var methodNames = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (var name in procedures)
        {
            var procedure = ReadProcedure(connection, name);
            if (!methodNames.Add(procedure.Name))
                throw new InvalidOperationException("Duplicate C# procedure name: " + procedure.Name);

            definitions.Add(procedure);
        }
    }
}
