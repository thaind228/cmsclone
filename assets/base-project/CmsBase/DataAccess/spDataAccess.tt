<#+
sealed class SqlType
{
    public SqlType(SqlDbType ado, string clr, bool sized = false)
    {
        Ado = ado;
        Clr = clr;
        Sized = sized;
    }

    public readonly SqlDbType Ado;
    public readonly string Clr;
    public readonly bool Sized;
}

sealed class Parameter
{
    public string Name;
    public SqlType Type;
    public int Length;
    public byte Precision;
    public byte Scale;
    public bool Output;
}

sealed class Column
{
    public string Name;
    public SqlType Type;
    public bool Nullable;
}

sealed class Procedure
{
    public string Name;
    public string SqlName;
    public readonly List<Parameter> Parameters = new List<Parameter>();
    public readonly List<Column> Columns = new List<Column>();
    public IEnumerable<Parameter> Outputs { get { return Parameters.Where(p => p.Output); } }
}

Procedure ReadProcedure(SqlConnection connection, string qualifiedName)
{
    var parts = qualifiedName.Split('.');
    if (parts.Length != 2)
        throw new InvalidOperationException("Use schema.procedure: " + qualifiedName);

    var schema = Identifier(parts[0]);
    var name = Identifier(parts[1]);
    var procedure = new Procedure { Name = name, SqlName = "[" + schema + "].[" + name + "]" };
    int objectId;

    using (var command = new SqlCommand(@"
        SELECT p.object_id
        FROM sys.procedures AS p
        JOIN sys.schemas AS s ON p.schema_id = s.schema_id
        WHERE s.name = @schema AND p.name = @name AND p.is_ms_shipped = 0;", connection))
    {
        command.Parameters.Add("@schema", SqlDbType.NVarChar, 128).Value = schema;
        command.Parameters.Add("@name", SqlDbType.NVarChar, 128).Value = name;
        var id = command.ExecuteScalar();
        if (id == null)
            throw new InvalidOperationException("Procedure is missing or not visible: " + qualifiedName);
        objectId = (int)id;
    }

    using (var command = new SqlCommand(@"
        SELECT p.name, TYPE_NAME(p.system_type_id), p.max_length, p.precision, p.scale, p.is_output
        FROM sys.parameters AS p
        WHERE p.object_id = @id AND p.parameter_id > 0
        ORDER BY p.parameter_id;", connection))
    {
        command.Parameters.Add("@id", SqlDbType.Int).Value = objectId;
        using (var reader = command.ExecuteReader())
        {
            while (reader.Read())
            {
                var typeName = reader.IsDBNull(1) ? "" : reader.GetString(1);
                int length = reader.GetInt16(2);
                if (length > 0 && (typeName == "nchar" || typeName == "nvarchar"))
                    length /= 2;

                procedure.Parameters.Add(new Parameter {
                    Name = Identifier(reader.GetString(0).TrimStart('@')),
                    Type = FindType(typeName, qualifiedName),
                    Length = length,
                    Precision = reader.GetByte(3),
                    Scale = reader.GetByte(4),
                    Output = reader.GetBoolean(5)
                });
            }
        }
    }

    using (var command = new SqlCommand(@"
        SELECT name, system_type_name, is_nullable, error_number
        FROM sys.dm_exec_describe_first_result_set_for_object(@id, 0)
        ORDER BY column_ordinal;", connection))
    {
        command.Parameters.Add("@id", SqlDbType.Int).Value = objectId;
        var names = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        using (var reader = command.ExecuteReader())
        {
            while (reader.Read())
            {
                if (!reader.IsDBNull(3))
                    throw new InvalidOperationException("Result metadata unavailable for " + qualifiedName +
                        " (SQL metadata error " + reader.GetInt32(3) + "). Use the verified result contract.");

                var column = Identifier(reader.IsDBNull(0) ? "" : reader.GetString(0));
                if (!names.Add(column) || column == name + "Model")
                    throw new InvalidOperationException("Result column needs a distinct C# name: " + column + " in " + qualifiedName);

                procedure.Columns.Add(new Column {
                    Name = column,
                    Type = FindType(reader.IsDBNull(1) ? "" : reader.GetString(1).Split('(')[0], qualifiedName),
                    Nullable = reader.IsDBNull(2) || reader.GetBoolean(2)
                });
            }
        }
    }

    return procedure;
}

string Identifier(string value)
{
    if (!Regex.IsMatch(value, @"\A[A-Za-z_][A-Za-z0-9_]{0,127}\z"))
        throw new InvalidOperationException("Use an explicit adapter for unsupported SQL identifier: " + value);
    return value;
}

bool IsReference(string clr) { return clr == "string" || clr == "byte[]" || clr == "object"; }

readonly Dictionary<string, SqlType> Types = new Dictionary<string, SqlType>(StringComparer.OrdinalIgnoreCase)
{
    { "tinyint", new SqlType(SqlDbType.TinyInt, "byte") },
    { "smallint", new SqlType(SqlDbType.SmallInt, "short") },
    { "int", new SqlType(SqlDbType.Int, "int") },
    { "bigint", new SqlType(SqlDbType.BigInt, "long") },
    { "bit", new SqlType(SqlDbType.Bit, "bool") },
    { "float", new SqlType(SqlDbType.Float, "double") },
    { "real", new SqlType(SqlDbType.Real, "float") },
    { "decimal", new SqlType(SqlDbType.Decimal, "decimal") },
    { "numeric", new SqlType(SqlDbType.Decimal, "decimal") },
    { "money", new SqlType(SqlDbType.Money, "decimal") },
    { "smallmoney", new SqlType(SqlDbType.SmallMoney, "decimal") },
    { "date", new SqlType(SqlDbType.Date, "DateTime") },
    { "datetime", new SqlType(SqlDbType.DateTime, "DateTime") },
    { "datetime2", new SqlType(SqlDbType.DateTime2, "DateTime") },
    { "smalldatetime", new SqlType(SqlDbType.SmallDateTime, "DateTime") },
    { "datetimeoffset", new SqlType(SqlDbType.DateTimeOffset, "DateTimeOffset") },
    { "time", new SqlType(SqlDbType.Time, "TimeSpan") },
    { "uniqueidentifier", new SqlType(SqlDbType.UniqueIdentifier, "Guid") },
    { "char", new SqlType(SqlDbType.Char, "string", true) },
    { "nchar", new SqlType(SqlDbType.NChar, "string", true) },
    { "varchar", new SqlType(SqlDbType.VarChar, "string", true) },
    { "nvarchar", new SqlType(SqlDbType.NVarChar, "string", true) },
    { "binary", new SqlType(SqlDbType.Binary, "byte[]", true) },
    { "varbinary", new SqlType(SqlDbType.VarBinary, "byte[]", true) },
    { "timestamp", new SqlType(SqlDbType.Timestamp, "byte[]") }
};

SqlType FindType(string name, string procedure)
{
    SqlType result;
    if (!Types.TryGetValue(name, out result))
        throw new InvalidOperationException("Unsupported SQL type in " + procedure + ": " + name);
    return result;
}
