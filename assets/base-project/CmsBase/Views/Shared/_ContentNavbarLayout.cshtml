@{
    Layout = "_CommonMasterLayout";
}

@section VendorStyles { @await RenderSectionAsync("VendorStyles", required: false) }
@section PageStyles { @await RenderSectionAsync("PageStyles", required: false) }
@section VendorScripts { @await RenderSectionAsync("VendorScripts", required: false) }
@section PageScripts { @await RenderSectionAsync("PageScripts", required: false) }

<a class="cms-skip-link" href="#cms-main">Đến nội dung chính</a>
<div class="cms-shell">
    @await Component.InvokeAsync("VerticalMenu", new { overview = false })
    <div class="cms-workspace">
        @await Html.PartialAsync("Sections/Navbar/_Navbar")
        <main class="cms-content" id="cms-main" tabindex="-1">
            @RenderBody()
        </main>
        @await Html.PartialAsync("Sections/Footer/_Footer")
    </div>
</div>
