@model IReadOnlyList<CmsNavigationGroup>
@{
    var isHome = ViewContext.RouteData.Values["controller"]?.ToString() == "Home"
        && ViewContext.RouteData.Values["action"]?.ToString() == "Index";
}

<aside class="cms-sidebar offcanvas-xl offcanvas-start" id="cms-menu" tabindex="-1" aria-labelledby="cms-menu-title">
    <div class="cms-sidebar-inner">
        <div class="cms-sidebar-header">
            <partial name="Sections/_Brand" />
            <button type="button" class="cms-icon-button cms-sidebar-close d-xl-none" data-bs-dismiss="offcanvas"
                    data-bs-target="#cms-menu" aria-label="Đóng điều hướng">
                <i class="ri ri-close-line" aria-hidden="true"></i>
            </button>
        </div>

        <nav class="cms-sidebar-nav" aria-label="Điều hướng chính">
            <p class="cms-sidebar-label" id="cms-menu-title">Không gian quản trị</p>
            <a asp-controller="Home" asp-action="Index" class="cms-nav-link" aria-current="@(isHome ? "page" : null)">
                <i class="ri ri-dashboard-3-line" aria-hidden="true"></i>
                <span>Tổng quan</span>
            </a>

            @if (Model.Count > 0)
            {
                <p class="cms-sidebar-label">Chức năng</p>
                @foreach (var group in Model)
                {
                    <details class="cms-nav-group" open="@(group.Links.Any(link => link.IsCurrent) ? "open" : null)">
                        <summary class="cms-nav-link">
                            <i class="ri @group.Icon" aria-hidden="true"></i>
                            <span>@group.Name</span>
                            <i class="ri ri-arrow-down-s-line cms-nav-chevron" aria-hidden="true"></i>
                        </summary>
                        <ul class="cms-nav-sublist">
                            @foreach (var link in group.Links)
                            {
                                <li>
                                    <a asp-controller="@link.Controller" asp-action="@link.Action"
                                       aria-current="@(link.IsCurrent ? "page" : null)">@link.Name</a>
                                </li>
                            }
                        </ul>
                    </details>
                }
            }
        </nav>

        <div class="cms-sidebar-footer">
            <i class="ri ri-shield-user-line" aria-hidden="true"></i>
            <span>Hệ thống quản trị nội bộ</span>
        </div>
    </div>
</aside>
