<dialog id="cms-image-picker-dialog" class="cms-media-dialog" aria-labelledby="cms-image-picker-title">
    <div class="cms-media-dialog-header">
        <h2 id="cms-image-picker-title" class="h5 mb-0">
            <i class="ri ri-folder-open-line" aria-hidden="true"></i>
            Thư viện ảnh
        </h2>
        <button type="button" class="cms-icon-button" aria-label="Đóng thư viện ảnh" data-cms-image-close>
            <i class="ri ri-close-line" aria-hidden="true"></i>
        </button>
    </div>
    <iframe title="Chọn ảnh từ máy chủ"></iframe>
</dialog>

<dialog id="cms-image-preview-dialog" class="cms-media-dialog cms-image-preview" aria-labelledby="cms-image-preview-title">
    <div class="cms-media-dialog-header">
        <h2 id="cms-image-preview-title" class="h5 mb-0">Xem trước ảnh</h2>
        <button type="button" class="cms-icon-button" aria-label="Đóng xem trước" data-cms-preview-close autofocus>
            <i class="ri ri-close-line" aria-hidden="true"></i>
        </button>
    </div>
    <div class="cms-image-preview-body">
        <p class="m-0" role="status" data-cms-preview-status></p>
        <img alt="Ảnh xem trước" hidden />
    </div>
</dialog>
