@if (ViewData["MinimalAssets"] is not true)
{
    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
}
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

@if (ViewData["UseSweetAlert"] is true)
{
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
}
@if (ViewData["UseDataTables"] is true)
{
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
}
@if (ViewData["UseNestable"] is true)
{
    <script src="~/vendor/js/jquery.nestable.js" asp-append-version="true"></script>
}
@if (ViewData["UseTreeView"] is true)
{
    <script src="~/vendor/js/bootstrap-treeview.js" asp-append-version="true"></script>
}
@if (ViewData["UseDatepicker"] is true)
{
    <script src="https://cdn.jsdelivr.net/npm/air-datepicker@3.5.3/air-datepicker.js"></script>
}
@if (ViewData["UseSelect2"] is true)
{
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="~/js/cms-select.js" asp-append-version="true"></script>
}
@if (ViewData["UseEditor"] is true)
{
    <script src="~/lib/ckeditor5/ckeditor5.umd.js" asp-append-version="true"></script>
    <script src="~/js/ckeditor-config.js" asp-append-version="true"></script>
}
