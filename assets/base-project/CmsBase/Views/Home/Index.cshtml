@{
    ViewData["Title"] = "Tổng quan";
    ViewData["MinimalAssets"] = true;
}

<section class="cms-hero" aria-labelledby="cms-hero-title">
    <div class="cms-hero-content">
        <h1 id="cms-hero-title">Trung tâm quản trị<br /><span>@ViewData["CmsBrand"]</span></h1>
        <p>Truy cập các chức năng được cấp quyền cho tài khoản của bạn.</p>
        <a class="btn cms-hero-button" href="#cms-functions">
            Khám phá chức năng <i class="ri ri-arrow-right-line" aria-hidden="true"></i>
        </a>
    </div>
</section>

@await Component.InvokeAsync("VerticalMenu", new { overview = true })
