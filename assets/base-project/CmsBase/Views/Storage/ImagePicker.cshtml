@{
    Layout = "_BlankLayout";
    ViewData["Title"] = "Thư viện ảnh";
    ViewData["MinimalAssets"] = true;
    var canUpload = ViewData["CanUpload"] is true;
    var canDelete = ViewData["CanDelete"] is true;
    var imageOnly = ViewData["ImageOnly"] is true;
    var inDialog = ViewData["PickerDialog"] is true;
}

<main id="storage-picker" class="cms-media-picker"
      data-image-only="@(imageOnly ? "true" : "false")"
      data-in-dialog="@(inDialog ? "true" : "false")"
      data-list-url="@Url.Action("GetFiles", "Storage")"
      data-upload-url="@Url.Action("Upload", "Storage")"
      data-create-folder-url="@Url.Action("CreateFolder", "Storage")"
      data-delete-url="@Url.Action("Delete", "Storage")"
      data-delete-folder-url="@Url.Action("DeleteFolder", "Storage")">
    <header class="cms-media-toolbar">
        @if (!inDialog)
        {
            <h1 class="cms-page-heading mb-3">Thư viện ảnh</h1>
        }
        <div class="cms-media-toolbar-row">
            <label class="input-group cms-media-search">
                <span class="input-group-text"><i class="ri ri-search-line" aria-hidden="true"></i></span>
                <input class="form-control" type="search" aria-label="Tìm trong thư mục hiện tại"
                       placeholder="Tìm trong thư mục…" data-media-search />
            </label>
            @if (canUpload)
            {
                <button type="button" class="btn btn-outline-secondary" data-media-new-folder aria-expanded="false"
                        aria-controls="storage-new-folder">Tạo thư mục</button>
                <button type="button" class="btn btn-outline-secondary d-inline-flex align-items-center gap-1" data-media-upload>
                    <i class="ri ri-upload-cloud-2-line" aria-hidden="true"></i> Tải lên
                </button>
                <input type="file" data-media-file-input multiple hidden
                       accept="@(imageOnly ? "image/*" : "image/*,video/mp4,.pdf,.doc,.docx,.xls,.xlsx,.zip,.rar,.apk")" />
            }
        </div>
        @if (canUpload)
        {
            <form id="storage-new-folder" class="cms-media-toolbar-row mt-2" hidden>
                <input name="folderName" class="form-control" aria-label="Tên thư mục mới" placeholder="Tên thư mục mới" required />
                <button class="btn btn-primary" type="submit">Tạo</button>
            </form>
        }
        @if (canUpload || canDelete)
        {
            @Html.AntiForgeryToken()
        }
        <nav class="cms-media-path" aria-label="Đường dẫn thư mục">
            <ol class="breadcrumb mb-0" data-media-path></ol>
        </nav>
    </header>

    <div class="cms-media-results">
        <div class="cms-media-grid" data-media-grid></div>
        <p class="cms-media-notice" data-media-notice role="status"></p>
        <div class="text-center mt-3" data-media-pagination hidden>
            <button type="button" class="btn btn-outline-secondary btn-sm" data-media-more>Tải thêm</button>
        </div>
    </div>

    <footer class="cms-media-footer">
        <label class="cms-media-selection">
            <span class="small fw-semibold">URL đã chọn</span>
            <input type="text" class="form-control form-control-sm" placeholder="Chọn một ảnh để lấy URL" readonly data-media-selection />
        </label>
        @if (inDialog)
        {
            <button type="button" class="btn btn-outline-secondary" data-media-cancel>Hủy</button>
        }
        <button type="button" class="btn btn-primary" data-media-confirm disabled>Chọn ảnh</button>
    </footer>

    <template data-media-card>
        <article class="cms-media-card">
            <button type="button" class="cms-media-card-select">
                <span class="cms-media-preview">
                    <i class="ri ri-file-list-3-line" aria-hidden="true"></i>
                </span>
                <span class="cms-media-name"></span>
            </button>
            @if (canDelete)
            {
                <button type="button" class="cms-media-delete" aria-label="Xóa" title="Xóa">
                    <i class="ri ri-delete-bin-6-line" aria-hidden="true"></i>
                </button>
            }
        </article>
    </template>
</main>

@section PageScripts {
    <script src="~/js/storage-image-picker.js" asp-append-version="true"></script>
}
