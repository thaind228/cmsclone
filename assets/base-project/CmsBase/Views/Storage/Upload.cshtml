@{
    ViewData["Title"] = "Tải tệp lên CDN";
}

<section class="cms-panel cms-upload" aria-labelledby="upload-title">
    @Html.AntiForgeryToken()
    <div class="d-flex align-items-center gap-3 mb-4">
        <span class="cms-feature-icon"><i class="ri ri-upload-cloud-2-line" aria-hidden="true"></i></span>
        <h1 class="cms-page-heading" id="upload-title">Tải tệp lên CDN</h1>
    </div>
    <div class="cms-upload-input mb-4">
        <label for="files" class="form-label">Chọn tệp để tải lên</label>
        <input type="file" id="files" multiple class="form-control" />
    </div>
    <button class="btn btn-primary" id="btnUpload" type="button">Tải lên</button>
    <pre id="result" class="cms-upload-result" role="status"></pre>
</section>

@section PageScripts
{
    <script>

              $("#btnUpload").click(async function () {
            var files = $("#files")[0].files;

            if (!files.length) {
                alert("Chọn file.");
                return;
            }

            $("#btnUpload").prop("disabled", true);

            var successFiles = [];
            var errorFiles = [];

            for (var i = 0; i < files.length; i++) {
                var formData = new FormData();
                formData.append("files", files[i]);
                formData.append("__RequestVerificationToken", $(".cms-upload input[name='__RequestVerificationToken']").val());

                $("#result").text("Đang upload " + (i + 1) + "/" + files.length + ": " + files[i].name);

                try {
                    var res = await $.ajax({
                        url: '@Url.Action("Upload", "Storage")',
                        type: "POST",
                        data: formData,
                        processData: false,
                        contentType: false,
                        timeout: 0
                    });

                    if (res && res.success) {
                        successFiles.push(files[i].name);
                    } else {
                        errorFiles.push(files[i].name + " - " + (res.message || "Upload thất bại"));
                    }
                } catch (xhr) {
                    errorFiles.push(files[i].name + " - HTTP " + xhr.status);
                }
            }

            $("#btnUpload").prop("disabled", false);

            $("#result").text(
                "HOÀN TẤT\n\n" +
                "Thành công: " + successFiles.length + "/" + files.length + "\n" +
                successFiles.join("\n") +
                "\n\nThất bại: " + errorFiles.length + "\n" +
                errorFiles.join("\n")
            );

            alert("Upload thành công " + successFiles.length + "/" + files.length + " file.");
        });

    </script>
}
